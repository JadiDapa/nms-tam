# Postgres (same database as the engine; this app uses the "public" schema, the engine uses "nms_monitoring")
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nms-tam"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Monitoring engine (server-side only)
ENGINE_URL=http://127.0.0.1:8088
ENGINE_API_KEY=

# Public URL of this app (used in invitation links)
APP_URL=http://localhost:3000

# Set true ONLY in development: lets clients monitor private/loopback addresses
ALLOW_PRIVATE_TARGETS=false

# Send visitors to our own auth pages instead of Clerk hosted ones
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional: link behind the "Customer support" button for clients (e.g. mailto:help@example.com or a WhatsApp/help-desk URL)
SUPPORT_URL=

# Optional: base map for the device map. Defaults to the public OpenStreetMap tiles (fine for light use).
# For heavy traffic use a tile provider you have an account with and set the attribution it requires.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
